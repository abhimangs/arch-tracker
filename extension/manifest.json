{
  "manifest_version": 3,
  "name": "arch-tracker",
  "version": "0.2.0",
  "description": "Tells the local arch-tracker daemon which tab is active: host and title only, never paths, queries or incognito details.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116",
  "key": ""
}
