[Unit]
Description=arch-tracker screen-time and activity tracker
Documentation=https://github.com/abhimangs/arch-tracker
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=notify
ExecStart=/usr/bin/arch-tracker daemon
Restart=on-failure
RestartSec=5
Nice=10
MemoryMax=64M
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
