# Local package for arch-tracker. Build and install from this folder:
#   makepkg -si
# For the AUR later, replace the "$startdir/.." source with a release tarball.

pkgname=arch-tracker
pkgver=0.1.1
pkgrel=1
pkgdesc="Local screen-time and activity tracker for KDE Plasma, GNOME, Hyprland and Sway on Wayland"
arch=('x86_64')
license=('MIT')
depends=('sqlite' 'gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=('plasma-browser-integration: fallback for browser tabs when the extension is not loaded'
            'kitty: exact terminal tab tracking through remote control'
            'tmux: see inside tmux panes'
            'gnome-shell-extension-appindicator: the tray icon on GNOME')
install=arch-tracker.install
options=('!lto' '!debug')

_root() { cd "$startdir/.."; }

prepare() {
  _root
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  _root
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  _root
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release
}

package() {
  _root
  sh packaging/install-files.sh . "$srcdir/target/release/arch-tracker" "$pkgdir" "$pkgname"
}
