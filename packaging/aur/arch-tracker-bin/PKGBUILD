# Maintainer: abhimangs (https://github.com/abhimangs)
# arch-tracker's prebuilt release binary. scripts/aur-bump.sh sets the version and checksum after
# each release; packaging/install-files.sh (in the release tarball) installs the files.

pkgname=arch-tracker-bin
_name=arch-tracker
pkgver=0.1.1
pkgrel=1
pkgdesc="Local screen-time and activity tracker for KDE Plasma, GNOME, Hyprland and Sway on Wayland (prebuilt)"
arch=('x86_64')
url="https://github.com/abhimangs/arch-tracker"
license=('MIT')
depends=('sqlite' 'gcc-libs' 'glibc' 'hicolor-icon-theme')
optdepends=('plasma-browser-integration: fallback for browser tabs when the extension is not loaded'
            'kitty: exact terminal tab tracking through remote control'
            'tmux: see inside tmux panes'
            'gnome-shell-extension-appindicator: the tray icon on GNOME')
provides=("$_name=$pkgver")
conflicts=("$_name")
install=arch-tracker.install
options=('!debug' '!strip')
source=("$url/releases/download/v$pkgver/$_name-$pkgver-x86_64-linux.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$_name-$pkgver-x86_64-linux"
  sh packaging/install-files.sh . arch-tracker "$pkgdir" "$pkgname"
}
