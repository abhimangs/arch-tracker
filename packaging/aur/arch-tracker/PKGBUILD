# Maintainer: abhimangs (https://github.com/abhimangs)
# arch-tracker built from its release source. scripts/aur-bump.sh sets the version and checksum
# after each release; packaging/install-files.sh (in the source) installs the files.

pkgname=arch-tracker
pkgver=0.2.0
pkgrel=1
pkgdesc="Local screen-time and activity tracker for KDE Plasma, GNOME, Hyprland and Sway on Wayland"
arch=('x86_64')
url="https://github.com/abhimangs/arch-tracker"
license=('MIT')
depends=('sqlite' 'gcc-libs' 'glibc' 'hicolor-icon-theme')
makedepends=('cargo')
optdepends=('plasma-browser-integration: fallback for browser tabs when the extension is not loaded'
            'kitty: exact terminal tab tracking through remote control'
            'tmux: see inside tmux panes'
            'gnome-shell-extension-appindicator: the tray icon on GNOME')
install=arch-tracker.install
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('d105a93eab507d01f2dfb975292f31b313765c4834e9cc37536dc8e4d88ea397')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  sh packaging/install-files.sh . "${CARGO_TARGET_DIR:-target}/release/arch-tracker" "$pkgdir" "$pkgname"
}
